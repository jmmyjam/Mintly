# Production builds call the API same-origin under /api; Caddy strips the
# prefix and proxies to the backend. No CORS, no baked-in host.
VITE_API_BASE=/api

# TCGplayer affiliate (Impact) tracking-link base — uncomment and fill in once
# the affiliate application is approved, then rebuild the frontend. Tracking
# links are public identifiers, safe to commit. Unset = plain TCGplayer links.
# VITE_TCGPLAYER_IMPACT_LINK=

# eBay Partner Network campaign id (10 digits) — the same value as the server
# .env's EBAY_EPN_CAMPAIGN_ID. Campaign ids are public click-attribution ids,
# safe to commit. Tags the card pages' "Search on eBay" button with affiliate
# params; unset = plain untracked eBay links.
# VITE_EBAY_EPN_CAMPAIGN_ID=
