# Copy to .env (or .env.local) and adjust. Vite bakes these into the bundle
# at build time — they are public, never put secrets here.

# Backend API origin. Defaults to http://localhost:8000 when unset.
# Set to "" (empty) to make API calls relative to the page's own origin.
VITE_API_BASE=http://localhost:8000

# Impact tracking-link base for the TCGplayer affiliate program, e.g.
# https://tcgplayer.pxf.io/c/<pub>/<link>/<prog> — issued after affiliate
# approval. Unset = the Buy buttons use plain untracked TCGplayer links.
# VITE_TCGPLAYER_IMPACT_LINK=

# eBay Partner Network campaign id (10 digits) — the same value as the
# backend's EBAY_EPN_CAMPAIGN_ID; tags the card pages' "Search on eBay" button
# with affiliate params. Unset = plain untracked eBay links.
# VITE_EBAY_EPN_CAMPAIGN_ID=
